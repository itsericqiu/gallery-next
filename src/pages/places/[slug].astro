---
import PhotoGrid from '@/components/PhotoGrid.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { collectionsByType, type Collection } from '@/data/collections';
import { collectionSlugSegment, photosForCollection } from '@/lib/collections';
import { collectionSeoImage } from '@/lib/seo-images';
import { withBase } from '@/lib/urls';

export function getStaticPaths() {
  const places = collectionsByType('place');
  return places.map((collection, index) => ({
    params: { slug: collectionSlugSegment(collection) },
    props: { collection, nextCollection: places[(index + 1) % places.length] },
  }));
}

const { collection, nextCollection } = Astro.props as {
  collection: Collection;
  nextCollection: Collection;
};
const photos = photosForCollection(collection);
const seoImage = await collectionSeoImage(collection);
---

<BaseLayout
  title={collection.title}
  description={collection.description}
  path={collection.slug}
  image={seoImage.src}
  imageAlt={seoImage.alt}
  imageWidth={seoImage.width}
  imageHeight={seoImage.height}
>
  <section class="hero hero--collection">
    <p class="eyebrow"><a href={withBase('/places/')}>Places</a></p>
    <h1>{collection.title}</h1>
    <p class="lede">{collection.description}</p>
  </section>

  <PhotoGrid photos={photos} />

  <p class="collection-next">Next place: <a href={withBase(nextCollection.slug)}>{nextCollection.title}</a></p>
</BaseLayout>
